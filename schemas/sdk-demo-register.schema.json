{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haiven.dev:cli-data:sdk-demo-register:v1",
  "anyOf": [
    {
      "type": "object",
      "maxProperties": 0,
      "description": "Empty object kept when the command fails before assigning data."
    },
    {
      "properties": {
        "demo": {
          "type": "string"
        },
        "sdk_root": {
          "type": "string"
        },
        "sdk_revision": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "already_registered": {
          "type": "boolean"
        }
      },
      "type": "object",
      "required": [
        "demo",
        "sdk_root",
        "sdk_revision",
        "destination",
        "project",
        "already_registered"
      ]
    }
  ],
  "title": "haiven sdk demo register data",
  "description": "Command payload, or an empty object when the command fails before it assigns data. An empty object is not a successful payload."
}
