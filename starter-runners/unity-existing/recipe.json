{
  "api_version": "starter-recipe/v1",
  "id": "sdk/unity-existing",
  "version": "1.0.2",
  "description": "Pin and verify one immutable Haiven Unity SDK revision in a caller-owned existing project.",
  "runner": {
    "id": "haiven-unity-existing",
    "digest": "sha256:27a7710a693406866cea6efbdd5242884566aee91231715a974fe7d5d6b0b067",
    "protocol_version": 1
  },
  "operations": ["plan", "apply", "verify"],
  "parameters": [
    {"name": "sdk_revision", "type": "string", "required": true, "secret": false},
    {"name": "host_platform", "type": "string", "required": false, "secret": false}
  ],
  "requires": [],
  "sources": [
    {
      "id": "manual-guide",
      "kind": "overlay",
      "uri": "MANUAL.md",
      "revision": "2",
      "digest": "sha256:94b747fb12e051e0ecfa081f9e25aaef1169bf1a8781426cb96b7069262014af"
    },
    {
      "id": "manual-operations",
      "kind": "overlay",
      "uri": "manual-operations.json",
      "revision": "2",
      "digest": "sha256:89b5c9f80155a82bb9bd1ff0efb0eb341552624ab1b8dbe1726cf6c5fdb1cff3"
    }
  ],
  "prerequisites": [
    "Caller-owned existing Unity project",
    "Unity 2022.3 or newer",
    "Git on PATH when the project is in a Git worktree",
    "Python on PATH only when using the optional runner"
  ],
  "network_hosts": ["github.com"],
  "outputs": [
    {"path": "Packages/manifest.json", "scope": "file", "action": "replace"},
    {"path": "Packages/packages-lock.json", "scope": "file", "action": "replace"}
  ],
  "licenses": ["Haiven SDK license"],
  "access_requirements": ["Public GitHub access for Unity Package Manager"],
  "manual": {
    "guide_path": "MANUAL.md",
    "guide_digest": "sha256:94b747fb12e051e0ecfa081f9e25aaef1169bf1a8781426cb96b7069262014af",
    "operation_steps": {
      "plan": ["inspect-project"],
      "apply": ["pin-sdk-package", "import-sdk-package", "wire-sdk"],
      "verify": ["verify-package-lock", "verify-code-wiring"]
    }
  }
}
